# Copie ce fichier en .env et remplis les valeurs (en local).
# Sur Render, ces mêmes valeurs se mettent dans l'onglet "Environment".

# Obtenus sur https://my.telegram.org -> API development tools
TELETHON_API_ID=
TELETHON_API_HASH=

# Clé générée par "python3 login.py" (longue chaîne). À garder secrète.
TELETHON_SESSION=

# Envoi des alertes via TON bot (BotFather), comme AXONE.
TELEGRAM_BOT_TOKEN=
# Le canal où envoyer (ex: @axone_veille). Le bot doit y être ADMIN.
TELEGRAM_CHAT_ID=
