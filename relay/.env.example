# Copie ce fichier en .env et remplis les valeurs.
# Token du bot créé via @BotFather sur Telegram :
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# ID du chat/canal où recevoir les signaux (voir relay/README.md pour l'obtenir) :
TELEGRAM_CHAT_ID=123456789
# Doit être identique au "secret" dans le message d'alerte Pine :
WEBHOOK_SECRET=mets-un-secret-long-et-aleatoire
